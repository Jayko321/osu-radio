# Historical Ubuntu candidate inputs; unused by the current Arch build.
# Pinned inputs of the Linux build (sourced by build.sh). Change a value only on purpose:
# the release inputs recorded in BUILD-INFO.txt must stay traceable.
# Base environment: Ubuntu 22.04 x86_64 (glibc 2.35), the oldest supported AppImage base.
UBUNTU_BASE_URL=https://cdimage.ubuntu.com/ubuntu-base/releases/22.04/release/ubuntu-base-22.04.5-base-amd64.tar.gz
UBUNTU_BASE_SHA256=242cd8898b33ea806ef5f13b1076ed7c76f9f989d18384452f7166692438ff1a

# Prebuilt official Qt through aqtinstall; Qt is never built from source here. aqtinstall checks
# each downloaded archive against the SHA-256 published by download.qt.io; the Qt version is not
# raised silently, including inside the 6.8 branch.
AQT_VERSION=3.3.0
QT_VERSION=6.8.3
QT_ARCH=linux_gcc_64
# aqtinstall's default archives for 6.8.3 desktop are: icu qtbase qtdeclarative qtsvg qttools
# qttranslations qtwayland. QtShaderTools comes as the module below.
QT_MODULES="qtshadertools"

# Pinned .NET SDK (publishes the framework-dependent helper). SHA-512 from Microsoft's
# release metadata https://builds.dotnet.microsoft.com/dotnet/release-metadata/10.0/releases.json
DOTNET_SDK_VERSION=10.0.403
DOTNET_SDK_URL=https://builds.dotnet.microsoft.com/dotnet/Sdk/10.0.403/dotnet-sdk-10.0.403-linux-x64.tar.gz
DOTNET_SDK_SHA512=b7b3d8461cf98b07d2552ce9199702fa3ad010ac2671a5f8cd5136f7534e50f6855ba7bbb02b11494563f1d04156276a31cda1103b900e5eecd0d9473dc7b9c5

# Rust itself comes from rust-toolchain.toml; only the installer is pinned here.
RUSTUP_VERSION=1.29.2
RUSTUP_INIT_SHA256=5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4

# Ubuntu packages added to the base image (build tools, libclang for bindgen, ALSA headers,
# and the system libraries that the Qt 6 xcb/Wayland/GL stack and its plugins link against).
APT_PACKAGES="build-essential lld pkg-config ca-certificates curl git xz-utils file python3-venv python3-pip \
 libclang-dev libasound2-dev libgl1-mesa-dev libegl1 libxkbcommon-dev libxkbcommon-x11-0 \
 libfontconfig1-dev libfreetype-dev libdbus-1-dev libglib2.0-0 libxcb-cursor0 libxcb-icccm4 \
 libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 \
 libxcb-xkb1 libx11-xcb1 libwayland-client0 libwayland-cursor0 libwayland-egl1"
