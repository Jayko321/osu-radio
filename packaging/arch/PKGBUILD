# Source: v0.1.0-alpha, commit bf941c29b2e69fa73aca6c1c6a7c1643f3a7f3f9.
pkgname=osu-radio
pkgver=0.1.0alpha
pkgrel=1
pkgdesc='Desktop music player for local osu! libraries'
arch=('x86_64')
url='https://github.com/Jayko321/osu-radio'
license=('MIT')
depends=(
  'glibc' 'libgcc' 'libstdc++' 'alsa-lib'
  'qt6-base>=6.8' 'qt6-declarative>=6.8' 'qt6-svg' 'qt6-wayland'
  'dotnet-runtime-8.0' 'xdg-desktop-portal' 'xdg-desktop-portal-impl'
)
makedepends=('rustup' 'dotnet-sdk-8.0' 'lld' 'pkgconf')
# Rust links with LLD; GCC LTO objects are incompatible with that linker.
options=('!lto' '!debug')
optdepends=(
  'osu: osu!stable library (manually installed libraries also work)'
  'osu-lazer-bin: osu!lazer library (manually installed libraries also work)'
)
_version=0.1.0-alpha
_target=x86_64-unknown-linux-gnu
source=(
  "$pkgname-$_version.tar.gz::$url/archive/refs/tags/v$_version.tar.gz"
  'osu-radio.desktop'
)
sha256sums=(
  '15fa8e08b960cf00a47ec1ae935bf90c774bfccc17dc82f1100b0bf3668f1566'
  'f99337fc9f9d60437461a3e887b0f6259202de5774224f611b85eb6f03b1b2b9'
)

build() {
  cd "$srcdir/$pkgname-$_version"
  export CARGO_HOME="$srcdir/cargo-home"
  export RUSTUP_HOME="$srcdir/rustup-home"
  export CARGO_TARGET_DIR="$srcdir/target-production"
  export DOTNET_CLI_HOME="$srcdir/dotnet-home"
  export NUGET_PACKAGES="$srcdir/nuget-packages"
  export NUGET_HTTP_CACHE_PATH="$srcdir/nuget-http-cache"
  export XDG_CACHE_HOME="$srcdir/cache"
  export XDG_CONFIG_HOME="$srcdir/config"
  export DOTNET_CLI_TELEMETRY_OPTOUT=1
  export DOTNET_NOLOGO=1
  unset RUSTUP_TOOLCHAIN CARGO_ENCODED_RUSTFLAGS
  export RUSTFLAGS='-C link-arg=-fuse-ld=lld'
  export OSU_LAZER_REALM_PARSER_PATH=/usr/lib/osu-radio/osu-lazer-realm-parser

  rustup toolchain install --no-self-update

  # Select the declared SDK even when a newer SDK is also installed.
  local _sdk_version
  _sdk_version=$(dotnet --list-sdks | awk '/^8\./ { version=$1 } END { print version }')
  if [[ -z $_sdk_version ]]; then
    printf '%s\n' 'The dotnet-sdk-8.0 build dependency is required.' >&2
    return 1
  fi
  printf '{"sdk":{"version":"%s","rollForward":"latestPatch"}}\n' "$_sdk_version" \
    > tools/osu-lazer-realm-parser/global.json
  (
    cd tools/osu-lazer-realm-parser
    dotnet publish osu-lazer-realm-parser.csproj --configuration Release \
      --runtime linux-x64 --self-contained false --output "$srcdir/helper-publish"
  )

  # Defaults retain SQLite and API docs, matching the distribution notices.
  cargo build --release --locked --target "$_target" \
    -p osu-radio-qt -p osu-radio-server
}

package() {
  cd "$srcdir/$pkgname-$_version"
  install -Dm755 "$srcdir/target-production/$_target/release/osu-radio-qt" \
    "$pkgdir/usr/bin/osu-radio-qt"
  ln -s osu-radio-qt "$pkgdir/usr/bin/osu-radio"
  install -Dm755 "$srcdir/target-production/$_target/release/osu-radio-server" \
    "$pkgdir/usr/bin/osu-radio-server"
  install -d "$pkgdir/usr/lib/osu-radio"
  cp -r "$srcdir/helper-publish/." "$pkgdir/usr/lib/osu-radio/"
  install -Dm644 "$srcdir/osu-radio.desktop" \
    "$pkgdir/usr/share/applications/osu-radio.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/osu-radio/LICENSE"
  install -m644 packaging/arch/licenses/* "$pkgdir/usr/share/licenses/osu-radio/"
}
