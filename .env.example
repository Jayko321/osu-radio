# Local development configuration. Copy to .env; never commit real credentials.
# SQLite is the default Cargo backend. PostgreSQL requires a separate build:
# cargo build -p osu-radio-server --no-default-features --features postgres,docs --locked
# cargo build -p osu-radio-cli --no-default-features --features postgres --locked
# Do not enable sqlite and postgres together. URLs do not switch the backend.
# Standalone server reads .env from cwd/ancestors; process variables take priority.
# CLI database commands require .env and their backend URL.
# Qt does not load .env; its child server skips .env. Export variables in the
# launching process for Qt, its child, scanner overrides and build tools.

# SQLite: uncomment for CLI or a custom standalone/embedded-server database.
# Omit for the server default: XDG_DATA_HOME/osu-radio/osu-radio.db on Linux
# (fallback ~/.local/share), LOCALAPPDATA/osu-radio/osu-radio.db on Windows.
# SQLITE_DATABASE_URL=/absolute/path/to/osu-radio.db
# PostgreSQL: create a database and user first; replace all placeholders locally.
# POSTGRES_DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/osu_radio

# Standalone bind address (default 127.0.0.1:3000). Embedded server uses an
# automatically assigned local port supplied by its supervisor instead.
# OSU_RADIO_SERVER_ADDRESS=127.0.0.1:3000
# Set exactly 1 to skip standalone server .env loading.
# OSU_RADIO_SKIP_DOTENV=1

# Qt: connect to an existing server instead of starting a local child.
# OSU_RADIO_SERVER_URL=http://127.0.0.1:3000
# Override local server executable (otherwise sibling executable, then PATH).
# OSU_RADIO_SERVER_BIN=/absolute/path/to/osu-radio-server
# Scanner: override Realm helper at runtime and skip its build when exported
# during cargo build. Empty/invalid paths fail; use an absolute executable path.
# OSU_LAZER_REALM_PARSER_PATH=/absolute/path/to/osu-lazer-realm-parser

# Build tools (export before cargo; these are not loaded from .env):
# DOTNET_CLI_HOME=/absolute/path/to/dotnet-home
# QMAKE=/absolute/path/to/qmake6
# QMLLINT=/absolute/path/to/qmllint
# Cargo/Rustup and .NET also support their own standard environment settings.
# OSU_LAZER_REALM_PARSER_BUILT_PATH is generated by build.rs, not a user setting.

# OS integration inherits HOME, XDG_DATA_HOME, XDG_RUNTIME_DIR, TMPDIR/TMP/TEMP,
# DBUS_SESSION_BUS_ADDRESS on Linux and APPDATA/LOCALAPPDATA/USERPROFILE on
# Windows. Discovery also consults platform installation directories. Usually
# leave these untouched. Discord IPC discovery uses the platform runtime paths.
# Qt supports its standard QT_* settings; these are toolkit diagnostics, not
# application preferences. Playback/UI preferences are managed in the app.

# Optional test/benchmark controls (export explicitly, not ordinary settings):
# RADIO_DB_TEST_POSTGRES_URL=postgres://USER:PASSWORD@127.0.0.1:5432/TEST_DATABASE
# PostgreSQL tests may reset data: use a dedicated disposable database only.
# RADIO_SEARCH_BENCH_DB=/absolute/path/to/private-database-copy.db
# RADIO_SEARCH_BENCH_DIR=/absolute/path/to/benchmark-output
# RADIO_SEARCH_BENCH_COMPACT=0
# RADIO_SEARCH_BENCH_BINARY=/absolute/path/to/osu-radio-server
# RADIO_SEARCH_BENCH_WORKDIR=/absolute/path/to/private-working-directory
# OSU_RADIO_QT_SMOKE_TEST, OSU_RADIO_QT_PROBE_CASE, OSU_RADIO_MPRIS_PROBE* and
# fixture variables are internal test controls; use the documented test commands.
